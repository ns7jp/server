---
# Ansible 動的インベントリ: amazon.aws.aws_ec2 plugin
#
# 前提:
#   ansible-galaxy collection install amazon.aws
#   pip install boto3 botocore
#
# Terraform で作成した EC2 は次のタグを持つ:
#   - Application = "server-monitor"
#   - AnsibleHost = "true"
#   - Environment = "dev" or "prod"
#
# SSM Session Manager 経由で接続する場合は ansible_connection を上書きする:
#   ansible-playbook -i aws_ec2.yml \
#     -e ansible_connection=amazon.aws.aws_ssm \
#     playbooks/site.yml

plugin: amazon.aws.aws_ec2
regions:
  - ap-northeast-1

filters:
  tag:Application: server-monitor
  tag:AnsibleHost: "true"
  # fail closed: copy後にdev / staging / prodのいずれかへ必ず置換する。
  tag:Environment: "<REPLACE-WITH-ENVIRONMENT>"
  instance-state-name:
    - running

keyed_groups:
  - key: tags.Environment
    prefix: env
  - key: placement.availability_zone
    prefix: az
  - key: tags.Application
    prefix: app

hostnames:
  # instance-idを先頭にすると、D-2で復元した一時hostを--limit i-...で一意に指定できる。
  - instance-id
  - tag:Name
  - private-ip-address

compose:
  # SSH用private IPは維持しつつ、aws_ssm connectionにはinstance IDを明示する。
  ansible_host: private_ip_address
  ansible_aws_ssm_instance_id: instance_id
  monitor_node_name: tags.Name
  server_monitor_environment: tags.Environment | default('dev', true)
  # AWSだけはALBから到達できるようapp入口を全interfaceへbindする。EC2 SGと
  # EC2 SGをauthoritative boundaryにし、UFWはVPC CIDRのhost policyも記録する。
  # Docker NATがUFW INPUTを通るとは主張しない。
  app_monitor_bind_address: "'0.0.0.0'"
  server_monitor_alb_source_cidr: tags.AlbHealthCheckSourceCidr
  server_monitor_alb_target_port: "8080"

# SSM Session Manager を既定にする場合は次をアンコメント:
#   ansible_connection: '"amazon.aws.aws_ssm"'
#   ansible_aws_ssm_bucket_name: '"<REPLACE-WITH-SSM-BUCKET>"'
#   ansible_aws_ssm_region: '"ap-northeast-1"'

groups:
  # keyed_group名のsanitizationに依存せず、host tagそのものから対象groupを作る。
  monitor: "tags.Application == 'server-monitor'"
