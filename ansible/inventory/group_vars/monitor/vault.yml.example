---
# このファイルを `vault.yml` にコピーして、運用者の値を入れ、
# `ansible-vault encrypt vault.yml` で暗号化してローカル保管する。
# `vault.yml` 自体は暗号化後も `.gitignore` で除外し、リポジトリに含めない。
#
# 例：
#   cp vault.yml.example vault.yml
#   openssl rand -base64 32  # を 3 か所に貼る
#   ansible-vault encrypt vault.yml --vault-password-file ../../../.vault_pass

vault_monitor_password: "replace-with-a-long-random-password"
vault_metrics_token: "replace-with-a-long-random-token"
vault_grafana_admin_password: "replace-with-another-long-random-password"
# Slack 通知を使うときだけ設定する。それ以外は空文字のままでよい。
vault_slack_webhook_url: ""
