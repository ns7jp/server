{# Ansible-managed Alertmanager configuration. Do not edit on the host. #}
route:
  receiver: {{ 'slack-alerts' if alertmanager_slack_enabled | bool else 'local-alert-view' }}
  group_by: ["alertname", "instance"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: local-alert-view
{% if alertmanager_slack_enabled | bool %}
  - name: slack-alerts
    slack_configs:
      - api_url: {{ slack_webhook_url | default('') | quote }}
        channel: "#alerts"
        send_resolved: true
        title: '{% raw %}{{ template "slack.default.title" . }}{% endraw %}'
        text: '{% raw %}{{ template "slack.default.text" . }}{% endraw %}'
{% endif %}

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: ["instance"]
