{# Ansible-managed Alertmanager configuration. Do not edit on the host. #}
route:
  receiver: {{ 'slack-alerts' if alertmanager_slack_enabled | bool else ('validation-webhook' if alertmanager_webhook_enabled | bool else 'local-alert-view') }}
  group_by: ["alertname", "instance"]
  group_wait: {{ alertmanager_group_wait }}
  group_interval: {{ alertmanager_group_interval }}
  repeat_interval: {{ alertmanager_repeat_interval }}

receivers:
  - name: local-alert-view
{% if alertmanager_slack_enabled | bool %}
  - name: slack-alerts
    slack_configs:
      - api_url: {{ slack_webhook_url | default('') | quote }}
        channel: "#alerts"
        send_resolved: true
        title: '{% raw %}{{ template "slack.default.title" . }}{% endraw %}'
        text: '{% raw %}{{ template "slack.default.text" . }}{% endraw %}'
{% endif %}
{% if alertmanager_webhook_enabled | bool %}
  - name: validation-webhook
    webhook_configs:
      - url: {{ alertmanager_webhook_url | quote }}
        send_resolved: true
{% endif %}

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal: ["instance"]
