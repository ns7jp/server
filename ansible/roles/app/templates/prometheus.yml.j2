{# Ansible-managed Prometheus configuration. Do not edit on the host. #}
{# ansible_managed は既定でレンダー時刻を含み、毎回 changed になるため使わない
   （alertmanager.yml.j2 と同じ方針）。 #}
global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    monitor: {{ app_prometheus_monitor_label }}

rule_files:
  - /etc/prometheus/rules.yml
  - /etc/prometheus/slo-rules.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

{% if app_amp_remote_write_url %}
# 単一ホストPrometheusは、ホストが消えると時系列の正本も一緒に失われる
# （docs/roadmap/external-probe-central-telemetry.md）。Amazon Managed
# Service for Prometheus へ remote_write することで、ホスト外に正本を残す。
# EC2 instance roleに terraform/modules/central-metrics の
# remote_write_policy_arn がアタッチされている前提（sigv4はinstance
# metadataの認証情報を使う）。
remote_write:
  - url: "{{ app_amp_remote_write_url }}"
    sigv4:
      region: {{ app_amp_remote_write_region }}
    queue_config:
      max_samples_per_send: 1000
      max_shards: 30
      capacity: 2500
{% endif %}

scrape_configs:
  - job_name: server-monitor
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: /run/secrets/metrics_token
    static_configs:
      - targets: ["app:5000"]
        labels:
          environment: {{ server_monitor_environment }}

  # 監視サーバー 1 台が N 台の node_exporter を scrape する形。
  # 監視対象を増やすときは、監視スタックをもう 1 式立てるのではなく
  # app_node_exporter_targets へ 1 行足す。
  - job_name: linux-node
    static_configs:
      - targets: ["node-exporter:9100"]
        labels:
          environment: {{ server_monitor_environment }}
          host: {{ inventory_hostname }}
{% for target in app_node_exporter_targets %}
      - targets: ["{{ target.address }}"]
        labels:
          environment: {{ target.environment | default(server_monitor_environment) }}
          host: {{ target.host | default(target.address | regex_replace(':.*$', '')) }}
{% endfor %}

  # アラート経路自体の生存監視（「監視の監視」）
  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]
        labels:
          environment: {{ server_monitor_environment }}

  # Prometheus 自身。これが無いと prometheus_rule_evaluation_failures_total も
  # prometheus_notifications_dropped_total も取れず、「監視の監視」を名乗れない。
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
        labels:
          environment: {{ server_monitor_environment }}

  # blackbox-exporter 自身の up メトリクス
  - job_name: blackbox
    static_configs:
      - targets: ["blackbox:9115"]
        labels:
          environment: {{ server_monitor_environment }}

  # SLI: ユーザーが触る入口 (nginx) を通して /healthz を 30 秒ごとに probe する。
  # 監視対象を増やすときは app_blackbox_probe_targets へ 1 行足す
  # (windows_exporter host の IIS health エンドポイント等、node_exporter targets
  # と同じ「1 台の監視サーバーが N 台を見る」形)。対象が Docker ホスト外の実マシンの
  # 場合、到達性(実L3接続・Firewall許可)は監視対象ごとに別途確立が必要
  # (docs/build-package-windows/01-basic-design.md 3.1 参照)。
  - job_name: blackbox-probe-health
    metrics_path: /probe
    params:
      module: [http_2xx]
    scrape_interval: 30s
    scrape_timeout: 10s
    static_configs:
      - targets:
          - http://nginx:8080/healthz
        labels:
          environment: {{ server_monitor_environment }}
          slo_service: server-monitor
{% for target in app_blackbox_probe_targets %}
      - targets:
          - {{ target.url }}
        labels:
          environment: {{ target.environment | default(server_monitor_environment) }}
          slo_service: {{ target.slo_service | default('external') }}
          host: {{ target.host | default(target.url | regex_replace('^https?://([^/:]+).*$', '\\1')) }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115
