.venv/
__pycache__/
.pytest_cache/
*.pyc
.env
.artifacts/
deploy/secrets/*.txt
!deploy/secrets/*.example
deploy/alertmanager/alertmanager.ansible.yml

# Terraform
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfplan
crash.log
crash.*.log
# tfvars と backend.hcl は実値を含むためコミット禁止。雛形は *.example で配布する。
**/*.tfvars
!**/*.tfvars.example
**/backend.hcl
!**/backend.hcl.example
